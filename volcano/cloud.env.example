# Copy to volcano/cloud.env (gitignored) and deploy with:
#   npm run cloud -- cloud variables deploy --file volcano/cloud.env
# Keys from `npm run cloud -- projects keys anon list` / `... keys service list`.
VOLCANO_API_URL=https://api.volcano.dev
VOLCANO_ANON_KEY=ak-...
VOLCANO_SERVICE_KEY=sk-...
VOLCANO_DATABASE=payroll
NEXT_PUBLIC_VOLCANO_API_URL=https://api.volcano.dev
NEXT_PUBLIC_VOLCANO_ANON_KEY=ak-...
NEXT_PUBLIC_VOLCANO_DATABASE=payroll

# Chat assistant (server-only; see README "Chat assistant"). Optional: without them the chat
# runs on the built-in rules. Uncomment only what you use, and pass the same names with
# --variable on the frontend deploy.
# Bedrock: `sh scripts/aws/bedrock-signer.sh --create-key` fills in these four lines.
# LLM_URL=https://bedrock-runtime.us-east-2.amazonaws.com/openai/v1
# LLM_MODEL=openai.gpt-oss-120b-1:0
# BEDROCK_ACCESS_KEY_ID=
# BEDROCK_SECRET_ACCESS_KEY=
# Any other OpenAI-compatible endpoint: LLM_URL, LLM_MODEL and a fixed LLM_TOKEN.
# LLM_TOKEN=
# DECIDER_URL=
# DECIDER_TOKEN=
# AGENT_DECIDER_THRESHOLD=0.9

# Never add PAYROLL_ALLOW_UNCONFIRMED_EMAIL here.
