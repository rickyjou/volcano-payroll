# Copy to web/.env.local (gitignored).
NEXT_PUBLIC_VOLCANO_API_URL=http://localhost:8000
NEXT_PUBLIC_VOLCANO_ANON_KEY=ak-...
NEXT_PUBLIC_VOLCANO_DATABASE=payroll

# Server-only (no NEXT_PUBLIC_ prefix): used by /api/v1 for provider integrations.
VOLCANO_SERVICE_KEY=sk-...

# Chat assistant (server-only, optional). Without these the chat runs on the built-in rules;
# see README "Chat assistant".
DECIDER_URL=
# e.g. Bedrock: LLM_URL=https://bedrock-runtime.us-east-2.amazonaws.com/openai/v1 LLM_MODEL=openai.gpt-oss-120b-1:0
LLM_URL=
LLM_MODEL=
LLM_TOKEN=
